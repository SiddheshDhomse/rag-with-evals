# =====================================================================
# API Keys (Loaded automatically from this file)
# =====================================================================

# Groq API Key (Get free key from: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Supports free models: https://openrouter.ai/keys)
OPEN_ROUTE_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM API Key (Get free key & 1000 credits from: https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Ollama Base URL (Local model runner, default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# =====================================================================
# Model & Provider Defaults
# =====================================================================
# Default LLM Provider: "groq", "openrouter", "nvidia", or "ollama"
DEFAULT_LLM_PROVIDER=groq

# Default Models (Tested & Verified Active)
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
OPENROUTER_DEFAULT_MODEL=openrouter/free
NVIDIA_DEFAULT_MODEL=meta/llama-3.2-11b-vision-instruct
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# Embedding Configuration
# Provider: "huggingface", "ollama", or "nvidia"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# =====================================================================
# Storage Paths
# =====================================================================
CHROMA_PERSIST_DIR=storage/chroma
CHAT_HISTORY_DIR=storage/history
COLLECTION_NAME=rag_knowledge_base
